{
  "name": "pierre-ballif-cv",
  "version": "1.0.0",
  "private": true,
  "description": "Handlebars-rendered static CV web app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "handlebars": "^4.7.9",
    "html2canvas": "^1.4.1",
    "js-untar": "^2.0.0",
    "pako": "^3.0.2"
  },
  "optionalDependencies": {
    "jsonresume-theme-bold-header-statement": "^1.1.4",
    "jsonresume-theme-warggr": "https://github.com/warggr/cv-template#master",
    "jsonresume-theme-warggr-tabular": "https://github.com/warggr/cv-template#tabular"
  },
  "allowScripts": {
    "github:warggr/cv-template": true
  }
}
